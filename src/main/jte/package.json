{
  "scripts": {
    "scss:build": "sass ./input.scss:./input.css",
    "scss:watch": "sass --watch ./input.scss:./input.css",
    "tailwind:build": "npx @tailwindcss/cli -i input.css -o output.css",
    "tailwind:watch": "npx @tailwindcss/cli -i input.css -o output.css -w",
    "webpack:build": "set NODE_ENV=production && webpack --mode=production",
    "webpack:dev": "set NODE_ENV=development && webpack --mode=development --watch",
    "webpack:serve": "set NODE_ENV=development && webpack serve --mode=development",
    "build": "npm run scss:build && npm run tailwind:build && npm run webpack:build",
    "dev": "npm run tailwind:watch & npm run webpack:dev",
    "serve": "npm run webpack:serve"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "sass": "^1.89.2",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "webpack": "^5.100.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^4.15.1"
  }
}
